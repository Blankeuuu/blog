---
import '../styles/global.css';
import { SITE, resolvePath, absoluteUrl, getRssUrl, getPostsUrl, getArchiveUrl, getTagUrl } from '../lib/urls';
import SearchModal from '../components/editorial/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  articleDate?: Date;
  articleTags?: string[];
  canonicalUrl?: string;
}

const {
  title,
  description = SITE.description,
  ogImage,
  articleDate,
  articleTags,
  canonicalUrl,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.author}`;
const canonical = canonicalUrl || absoluteUrl(Astro.url.pathname);
const resolvedOgImage = ogImage ? (ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage)) : absoluteUrl('/og-default.png');
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph & Social -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content={SITE.locale} />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    {articleTags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- RSS & Sitemap -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (RSS 2.0)`} href={getRssUrl()} />
    <link rel="sitemap" href={resolvePath('/sitemap-index.xml')} />

    <!-- Motyw: Zawsze mroczna baza breakcore domyślnie -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('blankeu-theme');
        if (stored === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--bg-void)] text-[var(--color-ink)] selection:bg-[var(--color-blood)] selection:text-white flex flex-col font-body bg-schematic-grid relative overflow-x-hidden">
    <!-- Czerwona linia laserowa przecinająca górę ekranu (Inspo ref 3) -->
    <div class="h-[2px] w-full bg-[var(--color-blood)] shadow-[0_0_8px_var(--color-blood)]" aria-hidden="true"></div>

    <!-- Pasek górny: Dziki, porwany manifest telemetrii -->
    <aside aria-label="Telemetria" class="border-b border-[var(--color-border)] bg-[var(--bg-void)] text-[10px] font-mono py-1 px-3 sm:px-6 flex flex-wrap justify-between items-center text-[var(--color-ink-muted)] z-50 select-none">
      <div class="flex items-center gap-3">
        <span class="inline-block w-2 h-2 bg-[var(--color-blood)] animate-ping" aria-hidden="true"></span>
        <span class="text-[var(--color-blood)] font-bold tracking-widest breakcore-glitch">DEVLOG://SZYMON_POTYRA</span>
        <span class="hidden md:inline text-[var(--color-border)]">///</span>
        <span class="hidden md:inline text-[var(--color-ink)]">STATUS: ONLINE</span>
      </div>

      <div class="flex items-center gap-3 sm:gap-5 mt-1 sm:mt-0">
        <span id="utc-clock" class="text-[var(--color-ink)] font-bold">UTC: --:--:--</span>

        <!-- Przełącznik Audio Web Audio API -->
        <button
          type="button"
          id="audio-toggle-btn"
          class="px-2 py-0.5 border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:border-[var(--color-blood)] hover:text-[var(--color-blood)] transition-colors text-[9px] uppercase tracking-wider font-bold"
          title="Przełącznik dźwięków sprzętowych"
        >
          <span id="audio-toggle-label">[AUDIO: OFF]</span>
        </button>

        <!-- Przełącznik motywu (CRT Void / Spec Sheet) -->
        <button
          type="button"
          id="theme-toggle-btn"
          class="px-2 py-0.5 border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:border-[var(--color-blood)] hover:text-[var(--color-blood)] transition-colors text-[9px] uppercase tracking-wider"
          title="Przełącznik motywu: Mroczny Breakcore / Schemat"
        >
          <span id="theme-toggle-label">[THEME: DARK]</span>
        </button>

        <a
          href={SITE.portfolio}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[var(--color-blood)] hover:text-white transition-colors hidden sm:inline font-bold"
        >
          PORTFOLIO ↗
        </a>
      </div>
    </aside>

    <!-- Nagłówek serwisu: Porwana, asymetryczna kompozycja breakcore -->
    <header class="border-b border-[var(--color-border)] sticky top-0 z-40 bg-[var(--bg-void)]/95 backdrop-blur-md px-4 sm:px-8 py-3 transition-colors">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <!-- Logo / Stempel artystyczny -->
        <a href={resolvePath('/')} class="group flex items-baseline gap-3 focus:outline-none select-none">
          <div class="font-display font-black text-2xl sm:text-4xl tracking-tighter text-[var(--color-ink)] group-hover:text-[var(--color-blood)] transition-all transform group-hover:skew-x-[-4deg]">
            <span class="text-[var(--color-blood)] mr-1">/</span>{SITE.wordmark}
          </div>
          <div class="hidden sm:inline-block font-mono text-[9px] px-1.5 py-0.5 bg-[var(--color-blood)] text-black font-extrabold rotate-2">
            RAW BREAKCORE ART
          </div>
        </a>

        <!-- Nawigacja główna (Desktop) - czysta, surowa, bez żadnych '#' -->
        <nav aria-label="Menu główne" class="hidden md:flex items-center gap-5 lg:gap-7 font-mono text-xs">
          <a
            href={getPostsUrl()}
            class="hover:text-[var(--color-blood)] hover:line-through decoration-[var(--color-blood)] decoration-2 transition-colors font-bold tracking-wider"
          >
            WPISY
          </a>
          <a
            href={getTagUrl('')}
            class="hover:text-[var(--color-blood)] hover:line-through decoration-[var(--color-blood)] decoration-2 transition-colors font-bold tracking-wider"
          >
            TEMATY
          </a>
          <a
            href={getArchiveUrl()}
            class="hover:text-[var(--color-blood)] hover:line-through decoration-[var(--color-blood)] decoration-2 transition-colors font-bold tracking-wider"
          >
            ARCHIWUM
          </a>

          <!-- Wyszukiwarka -->
          <button
            type="button"
            data-search-trigger
            class="flex items-center gap-1.5 px-3 py-1 border border-[var(--color-blood)] bg-[var(--bg-shard)] text-[var(--color-blood)] hover:bg-[var(--color-blood)] hover:text-black font-bold transition-all shadow-[2px_2px_0_white]"
            title="Szukaj (Ctrl+K)"
          >
            <span>SZUKAJ</span>
            <kbd class="text-[9px] px-1 bg-[var(--bg-void)] text-white border border-[var(--color-border)]">^K</kbd>
          </button>
        </nav>

        <!-- Przycisk menu mobilnego -->
        <div class="flex items-center gap-2 md:hidden">
          <button
            type="button"
            data-search-trigger
            class="p-2 border border-[var(--color-blood)] text-[var(--color-blood)] text-xs font-mono font-bold"
            aria-label="Szukaj"
          >
            ^K
          </button>
          <button
            type="button"
            id="mobile-menu-btn"
            class="px-3 py-1.5 border-2 border-[var(--color-blood)] bg-[var(--bg-shard)] font-mono text-xs text-[var(--color-blood)] font-black"
            aria-label="Otwórz menu nawigacji"
            aria-expanded="false"
          >
            MENU
          </button>
        </div>
      </div>

      <!-- Rozwijane menu mobilne -->
      <div id="mobile-menu" class="hidden md:hidden pt-4 pb-2 border-t border-[var(--color-border)] mt-3 font-mono text-xs">
        <nav aria-label="Menu mobilne" class="flex flex-col gap-2.5">
          <a href={getPostsUrl()} class="px-2 py-1.5 border border-[var(--color-border)] hover:bg-[var(--color-blood)] hover:text-black font-bold">
            WPISY
          </a>
          <a href={getTagUrl('')} class="px-2 py-1.5 border border-[var(--color-border)] hover:bg-[var(--color-blood)] hover:text-black font-bold">
            TEMATY
          </a>
          <a href={getArchiveUrl()} class="px-2 py-1.5 border border-[var(--color-border)] hover:bg-[var(--color-blood)] hover:text-black font-bold">
            ARCHIWUM
          </a>
          <a href={SITE.portfolio} target="_blank" rel="noopener noreferrer" class="px-2 py-1.5 border border-[var(--color-blood)] text-[var(--color-blood)] font-bold">
            PORTFOLIO ↗
          </a>
          <div class="pt-2 border-t border-[var(--color-border)] flex justify-between items-center px-2">
            <span class="text-xs text-[var(--color-ink-muted)]">MOTYW:</span>
            <button
              type="button"
              id="mobile-theme-toggle"
              class="px-2 py-1 border border-[var(--color-border)] text-xs text-[var(--color-blood)]"
            >
              PRZEŁĄCZ MOTYW
            </button>
          </div>
        </nav>
      </div>
    </header>

    <!-- Główna zawartość strony -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Stopka: Brutalistyczny kolaż i zrzut obwodów drukowanych -->
    <footer class="border-t-2 border-[var(--color-blood)] bg-[var(--bg-void)] mt-24 py-12 px-4 sm:px-8 font-mono text-xs relative overflow-hidden">
      <!-- Czerwone linie wektorowe w tle stopki -->
      <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
        <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <line x1="0" y1="100%" x2="100%" y2="0" stroke="var(--color-blood)" stroke-width="1" />
          <line x1="20%" y1="0" x2="80%" y2="100%" stroke="var(--color-blood)" stroke-width="1" stroke-dasharray="4 4" />
        </svg>
      </div>

      <div class="max-w-7xl mx-auto space-y-8 relative z-10">
        <!-- Zrzut biletowy i kod kreskowy -->
        <div class="p-4 border border-[var(--color-border)] bg-[var(--bg-shard)] flex flex-wrap items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="text-[var(--color-blood)] font-extrabold tracking-widest text-sm font-display">
              GLITCH IS THE NEW AESTHETIC // DISTORTION // CHAOS // ANOMALY // DIGITAL DECAY
            </div>
            <div class="text-[10px] text-[var(--color-ink-muted)]">
              SZYMON POTYRA // DEVLOG TWÓRCZY // PROJEKTY I EKSPERYMENTY
            </div>
          </div>
          <span class="barcode-dense w-32 h-6 inline-block opacity-80" aria-hidden="true"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-xs">
          <!-- Kolumna 1 -->
          <div class="space-y-3">
            <div class="font-display font-black text-xl text-[var(--color-blood)] tracking-tight">
              {SITE.wordmark}
            </div>
            <p class="text-[var(--color-ink-muted)] leading-relaxed font-body text-sm">
              Eksperymentalny devlog twórczy, projekty fizyczne, elektronika oraz programowanie.
            </p>
            <div class="text-[10px] text-[var(--color-ink-muted)]">
              &copy; {new Date().getFullYear()} {SITE.author}. BRAK KOMPROMISÓW.
            </div>
          </div>

          <!-- Kolumna 2: Łączność -->
          <div class="space-y-2">
            <div class="text-[var(--color-blood)] font-bold tracking-wider">KOMUNIKACJA</div>
            <ul class="space-y-1.5">
              <li>
                <span class="text-[var(--color-ink-muted)]">POCZTA:</span>{' '}
                <a href={`mailto:${SITE.email}`} class="underline hover:text-[var(--color-blood)]">
                  {SITE.email}
                </a>
              </li>
              <li>
                <span class="text-[var(--color-ink-muted)]">GITHUB:</span>{' '}
                <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-blood)]">
                  {SITE.githubLogin}
                </a>
              </li>
              <li>
                <span class="text-[var(--color-ink-muted)]">PORTFOLIO:</span>{' '}
                <a href={SITE.portfolio} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--color-blood)]">
                  blankeuuu.github.io/portfolio/
                </a>
              </li>
              <li>
                <span class="text-[var(--color-ink-muted)]">STRUMIEŃ:</span>{' '}
                <a href={getRssUrl()} class="underline hover:text-[var(--color-blood)]">
                  rss.xml
                </a>
              </li>
            </ul>
          </div>

          <!-- Kolumna 3: Pages CMS & Runtime -->
          <div class="space-y-2">
            <div class="text-[var(--color-blood)] font-bold tracking-wider">SYSTEM PUBLIKACJI</div>
            <p class="text-[var(--color-ink-muted)] leading-relaxed text-[11px]">
              Astro 7 SSG // Pages CMS // Pagefind Search // GitHub Pages.
            </p>
            <div class="pt-2">
              <a
                href="https://app.pagescms.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-3 py-1.5 border border-[var(--color-blood)] bg-[var(--bg-shard)] text-[var(--color-blood)] hover:bg-[var(--color-blood)] hover:text-black font-bold text-[11px] transition-colors"
              >
                PAGES CMS LOGIN ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- Modal wyszukiwarki -->
    <SearchModal />

    <!-- Skrypty telemetryczne, audio i motywu -->
    <script>
      import { isAudioEnabled, toggleAudio, playClick, playBleep } from '../lib/audio';

      function initLayoutScripts() {
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const themeBtn = document.getElementById('theme-toggle-btn');
        const mobileThemeBtn = document.getElementById('mobile-theme-toggle');
        const themeLabel = document.getElementById('theme-toggle-label');
        const audioBtn = document.getElementById('audio-toggle-btn');
        const audioLabel = document.getElementById('audio-toggle-label');
        const clockEl = document.getElementById('utc-clock');

        function updateClock() {
          if (!clockEl) return;
          const now = new Date();
          const h = String(now.getUTCHours()).padStart(2, '0');
          const m = String(now.getUTCMinutes()).padStart(2, '0');
          const s = String(now.getUTCSeconds()).padStart(2, '0');
          clockEl.textContent = `UTC: ${h}:${m}:${s}`;
        }
        updateClock();
        setInterval(updateClock, 1000);

        function updateAudioLabel() {
          if (!audioLabel) return;
          const on = isAudioEnabled();
          audioLabel.textContent = on ? '[AUDIO: ON]' : '[AUDIO: OFF]';
          if (audioBtn) {
            if (on) {
              audioBtn.classList.add('border-[var(--color-blood)]', 'text-[var(--color-blood)]');
            } else {
              audioBtn.classList.remove('border-[var(--color-blood)]', 'text-[var(--color-blood)]');
            }
          }
        }
        updateAudioLabel();

        audioBtn?.addEventListener('click', () => {
          const enabled = toggleAudio();
          updateAudioLabel();
          if (enabled) {
            playBleep(880, 0.05);
          }
        });

        mobileBtn?.addEventListener('click', () => {
          playClick();
          const isHidden = mobileMenu?.classList.toggle('hidden');
          mobileBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        });

        function updateThemeLabel(theme: string) {
          if (!themeLabel) return;
          themeLabel.textContent = theme === 'light' ? '[THEME: SPEC]' : '[THEME: DARK]';
        }

        const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        updateThemeLabel(currentTheme);

        function triggerThemeToggle() {
          playClick();
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('blankeu-theme', next);
          updateThemeLabel(next);
        }

        themeBtn?.addEventListener('click', triggerThemeToggle);
        mobileThemeBtn?.addEventListener('click', triggerThemeToggle);

        document.querySelectorAll('a, button').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            if (el.hasAttribute('data-search-trigger') || el.id === 'audio-toggle-btn' || el.id === 'theme-toggle-btn') {
              playClick();
            }
          });
        });
      }

      if (typeof document !== 'undefined') {
        initLayoutScripts();
        document.addEventListener('astro:page-load', initLayoutScripts);
      }
    </script>
  </body>
</html>
