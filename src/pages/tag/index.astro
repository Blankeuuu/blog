---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TAGS } from '../../data/tags.mjs';
import { getTagCounts } from '../../lib/posts';
import { getTagUrl } from '../../lib/urls';

const tagCounts = await getTagCounts();
---

<BaseLayout
  title="Tematy i kategorie"
  description="Wszystkie obszary tematyczne bloga Szymona Potyry: refleksje, maker, elektronika, CAD, druk 3D, programowanie, smart home."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-12">
    <header class="border-b-2 border-[var(--color-blue)] pb-6 mb-10">
      <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-magenta)]">
        <span class="inline-block w-2.5 h-2.5 bg-[var(--color-magenta)]"></span>
        <span>[KLASYFIKACJA]</span>
      </div>
      <h1 class="font-display font-black text-4xl sm:text-5xl text-[var(--color-ink)] tracking-tight mt-1">
        Obszary tematyczne
      </h1>
      <p class="font-body text-lg text-[var(--color-ink-muted)] mt-2">
        Wybierz temat, aby wyświetlić powiązane artykuły, notatki techniczne i projekty.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {TAGS.map((t) => {
        const count = tagCounts[t.slug] || 0;
        return (
          <a
            href={getTagUrl(t.slug)}
            class="group p-6 border-2 border-[var(--color-border)] bg-[var(--color-card)] hover:border-[var(--color-magenta)] hover:shadow-[4px_4px_0_var(--color-blue)] transition-all"
          >
            <div class="flex items-center justify-between font-mono text-xs mb-3">
              <span class="text-[var(--color-blue)] font-bold">#{t.short}</span>
              <span class="px-2 py-0.5 border border-[var(--color-border)] bg-[var(--bg-paper)] text-[var(--color-ink-muted)]">
                {count} {count === 1 ? 'wpis' : count >= 2 && count <= 4 ? 'wpisy' : 'wpisów'}
              </span>
            </div>
            <h2 class="font-display font-bold text-xl text-[var(--color-ink)] group-hover:text-[var(--color-blue)] transition-colors">
              {t.label}
            </h2>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
