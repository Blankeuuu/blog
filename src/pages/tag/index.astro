---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TAGS } from '../../data/tags.mjs';
import { getTagCounts } from '../../lib/posts';
import { getTagUrl } from '../../lib/urls';

const tagCounts = await getTagCounts();
---

<BaseLayout
  title="Tematy"
  description="Wszystkie obszary tematyczne: refleksje, maker, elektronika, CAD, druk 3D, programowanie, smart home."
>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-8 py-12 md:py-16">
    <!-- Laser ray background decoration -->
    <div class="ray-line-blood top-20 left-4 w-72" aria-hidden="true"></div>
    <div class="ray-line-blood bottom-10 right-8 w-96 rotate-3" aria-hidden="true"></div>

    <!-- Nagłówek -->
    <header class="relative border-b-2 border-[var(--color-blood)] pb-8 mb-12">
      <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs mb-3">
        <div class="flex items-center gap-3">
          <span class="inline-block w-3 h-3 bg-[var(--color-blood)] animate-pulse"></span>
          <span class="text-[var(--color-blood)] font-black tracking-widest breakcore-glitch">
            SECTOR://TAGS
          </span>
        </div>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="font-display font-black text-4xl sm:text-6xl text-[var(--color-ink)] tracking-tighter uppercase">
            Tematy
          </h1>
        </div>

        <div class="shrink-0 font-mono text-xs border border-[var(--color-border)] p-3 bg-[var(--bg-shard)]/80">
          <div class="barcode-dense h-4 w-32 mb-1" aria-hidden="true"></div>
          <div class="text-[10px] text-[var(--color-ink-muted)] flex justify-between gap-4">
            <span>KATEGORII: {TAGS.length}</span>
            <span class="text-[var(--color-blood)] font-bold">ONLINE</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Siatka klastrów: szarpane kafle breakcore -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {TAGS.map((t, idx) => {
        const count = tagCounts[t.slug] || 0;
        const rotClass = idx % 3 === 0 ? '-rotate-1 hover:rotate-0' : idx % 3 === 1 ? 'rotate-1 hover:rotate-0' : 'hover:-rotate-1';

        return (
          <a
            href={getTagUrl(t.slug)}
            class={`shard-box p-6 block group transition-all duration-200 transform ${rotClass} hover:border-[var(--color-blood)] hover:shadow-[4px_4px_0_var(--color-blood)]`}
          >
            <!-- Nagłówek kafelka z kodem CRC i liczbą wpisów -->
            <div class="flex items-center justify-between font-mono text-xs mb-4 border-b border-[var(--color-border)] pb-2">
              <span class="text-[var(--color-blood)] font-black tracking-wider text-[11px] group-hover:text-white transition-colors">
                NODE_{t.short.toUpperCase()}
              </span>
              <span class="px-2 py-0.5 bg-[var(--bg-void)] border border-[var(--color-border)] text-[var(--color-acid)] text-[10px] font-bold">
                {count} {count === 1 ? 'WPIS' : count > 1 && count < 5 ? 'WPISY' : 'WPISÓW'}
              </span>
            </div>

            <div class="flex items-baseline justify-between gap-2">
              <h2 class="font-display font-black text-2xl text-[var(--color-ink)] group-hover:text-[var(--color-blood)] transition-colors tracking-tight">
                {t.label}
              </h2>
              <span class="font-mono text-sm text-[var(--color-blood)] font-bold group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>

            <!-- Mini dekoracja techniczna breakcore -->
            <div class="mt-4 pt-3 border-t border-[var(--color-border)] flex items-center justify-between text-[9px] font-mono text-[var(--color-ink-muted)]">
              <span>0x{t.slug.slice(0, 4).toUpperCase()}</span>
              <span class="barcode-dense h-2 w-16" aria-hidden="true"></span>
              <span>1F-2F</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
