---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/articles/PostCard.astro';
import EmptyState from '../../components/editorial/EmptyState.astro';
import { TAGS } from '../../data/tags.mjs';
import { getPostsByTag } from '../../lib/posts';

export function getStaticPaths() {
  return TAGS.map((t) => ({
    params: { tag: t.slug },
    props: { currentTag: t },
  }));
}

const { currentTag } = Astro.props;
const posts = await getPostsByTag(currentTag.slug);
const hasPosts = posts.length > 0;
---

<BaseLayout
  title={`Kategoria: ${currentTag.label}`}
  description={`Wpisy z kategorii ${currentTag.label} — notatki i projekty Szymona Potyry.`}
>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-8 py-12 md:py-16">
    <!-- Laser ray background decoration -->
    <div class="ray-line-blood top-24 left-8 w-64" aria-hidden="true"></div>

    <!-- Belka nagłówka kategorii w stylu Breakcore Shard -->
    <header class="relative border-b-2 border-[var(--color-blood)] pb-6 mb-12">
      <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs mb-3">
        <div class="flex items-center gap-3">
          <span class="inline-block w-3 h-3 bg-[var(--color-blood)] animate-pulse"></span>
          <span class="text-[var(--color-blood)] font-black tracking-widest breakcore-glitch">
            FILTER://NODE_{currentTag.short.toUpperCase()}
          </span>
        </div>

        <div class="flex items-center gap-4 text-xs font-mono">
          <span class="text-[var(--color-ink-muted)]">
            LICZBA WPISÓW: <strong class="text-[var(--color-acid)]">{posts.length}</strong>
          </span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h1 class="font-display font-black text-4xl sm:text-6xl text-[var(--color-ink)] tracking-tighter uppercase">
            {currentTag.label}
          </h1>
        </div>

        <a
          href="/tag/"
          class="inline-block font-mono text-xs px-3 py-1.5 border border-[var(--color-blood)] text-[var(--color-blood)] hover:bg-[var(--color-blood)] hover:text-black font-bold transition-all w-fit"
        >
          ← WSZYSTKIE TEMATY
        </a>
      </div>
    </header>

    <!-- Lista wpisów dla wybranego tagu w formie rozbitych zine shards -->
    {hasPosts ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post, idx) => (
          <PostCard post={post} index={idx + 1} />
        ))}
      </div>
    ) : (
      <EmptyState
        isTagFilter={true}
        message={`W kategorii „${currentTag.label}” nie opublikowano jeszcze żadnych wpisów.`}
      />
    )}
  </div>
</BaseLayout>
