---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/editorial/EmptyState.astro';
import { getPublishedPosts } from '../../lib/posts';
import { getPostUrl, getTagUrl } from '../../lib/urls';

const posts = await getPublishedPosts();
const hasPosts = posts.length > 0;

// Grupowanie wpisów według roku
interface YearGroup {
  year: number;
  posts: typeof posts;
}

const groupsByYear: YearGroup[] = [];
for (const post of posts) {
  const y = post.data.date.getFullYear();
  let g = groupsByYear.find((x) => x.year === y);
  if (!g) {
    g = { year: y, posts: [] };
    groupsByYear.push(g);
  }
  g.posts.push(post);
}
---

<BaseLayout
  title="Archiwum // CHRONOLOGY"
  description="Chronologiczny rejestr wszystkich publikacji i devlogów w dzienniku Szymona Potyry."
>
  <div class="relative max-w-4xl mx-auto px-4 sm:px-8 py-12 md:py-16">
    <!-- Laser ray background decoration -->
    <div class="ray-line-blood top-20 right-10 w-80 rotate-2" aria-hidden="true"></div>

    <header class="relative border-b-2 border-[var(--color-blood)] pb-8 mb-12">
      <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs mb-3">
        <div class="flex items-center gap-3">
          <span class="inline-block w-3 h-3 bg-[var(--color-blood)] animate-pulse"></span>
          <span class="text-[var(--color-blood)] font-black tracking-widest breakcore-glitch">
            CHRONOLOGY://ARCHIVE
          </span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h1 class="font-display font-black text-4xl sm:text-6xl text-[var(--color-ink)] tracking-tighter uppercase">
            Archiwum
          </h1>
        </div>

        <div class="barcode-dense h-6 w-28 shrink-0" aria-hidden="true"></div>
      </div>
    </header>

    {hasPosts ? (
      <div class="relative space-y-12">
        <!-- Pionowa linia laserowa breakcore z boku osi czasu -->
        <div class="hidden sm:block absolute top-0 bottom-0 left-6 w-[1px] bg-gradient-to-b from-[var(--color-blood)] via-[rgba(255,0,60,0.3)] to-transparent pointer-events-none" aria-hidden="true"></div>

        {groupsByYear.map((grp) => (
          <section
            aria-labelledby={`year-${grp.year}`}
            class="shard-box relative p-6 sm:p-8 space-y-6 sm:ml-12"
          >
            <!-- Nagłówek roku w stylu Breakcore Shard -->
            <div class="flex items-baseline justify-between border-b-2 border-[var(--color-blood)] pb-3">
              <div class="flex items-baseline gap-3">
                <h2 id={`year-${grp.year}`} class="font-display font-black text-3xl sm:text-4xl text-[var(--color-blood)] tracking-tighter">
                  ROK {grp.year}
                </h2>
              </div>
              <span class="font-mono text-xs text-[var(--color-ink-muted)] border border-[var(--color-border)] px-2 py-0.5 bg-[var(--bg-void)]">
                WPISÓW: <strong class="text-[var(--color-ink)]">{grp.posts.length}</strong>
              </span>
            </div>

            <!-- Lista wpisów bez jakichkolwiek znaków '#' -->
            <ul class="space-y-4 divide-y divide-[var(--color-border)] font-mono text-xs">
              {grp.posts.map((post) => {
                const dateStr = new Intl.DateTimeFormat('pl-PL', {
                  month: '2-digit',
                  day: '2-digit',
                }).format(post.data.date);

                return (
                  <li class="pt-4 first:pt-0 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 group">
                    <div class="flex items-baseline gap-3">
                      <time datetime={post.data.date.toISOString()} class="text-[var(--color-blood)] font-bold w-14 shrink-0">
                        {dateStr}
                      </time>
                      <a
                        href={getPostUrl(post.data.slug)}
                        class="font-display font-black text-lg sm:text-xl text-[var(--color-ink)] group-hover:text-[var(--color-blood)] transition-colors tracking-tight"
                      >
                        {post.data.title}
                      </a>
                    </div>

                    <div class="flex items-center gap-2 shrink-0 pl-16 sm:pl-0">
                      {post.data.tags?.slice(0, 2).map((t) => (
                        <a
                          href={getTagUrl(t)}
                          class="px-2 py-0.5 border border-[var(--color-border)] text-[10px] font-bold text-[var(--color-ink-muted)] hover:border-[var(--color-blood)] hover:text-[var(--color-blood)] bg-[var(--bg-void)] transition-colors uppercase"
                        >
                          {t}
                        </a>
                      ))}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <EmptyState />
    )}
  </div>
</BaseLayout>
