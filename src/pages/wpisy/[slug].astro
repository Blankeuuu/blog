---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/articles/BlockRenderer.astro';
import AsciiArt from '../../components/ascii/AsciiArt.astro';
import { getPublishedPosts } from '../../lib/posts';
import { estimateReadingTime } from '../../lib/posts';
import { tagLabel } from '../../data/tags.mjs';
import { getTagUrl, getPostsUrl, getPostUrl } from '../../lib/urls';
import { resolveImage } from '../../lib/images';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, idx) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      prevPost: idx < posts.length - 1 ? posts[idx + 1] : null,
      nextPost: idx > 0 ? posts[idx - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { title, excerpt, date, updated, tags = [], cover, coverAlt, seed, seoDescription, blocks = [] } = post.data;

const { Content, headings = [] } = await render(post);

// Oblicz szacunkowy czas czytania
const rawText = (post.body || '') + blocks.map((b) => (b.type === 'text' ? b.body : '')).join(' ');
const readingMinutes = estimateReadingTime(rawText);

const formattedDate = new Intl.DateTimeFormat('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const formattedUpdated = updated
  ? new Intl.DateTimeFormat('pl-PL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(updated)
  : null;

const coverMeta = cover ? await resolveImage(cover) : null;
const asciiSeed = seed || post.data.slug;
const hasToc = headings.filter((h) => h.depth <= 3).length >= 2;

// Hex hash
let hash = 0;
for (let i = 0; i < post.data.slug.length; i++) {
  hash = (hash << 5) - hash + post.data.slug.charCodeAt(i);
  hash |= 0;
}
const packetHex = '0x' + Math.abs(hash).toString(16).toUpperCase().padStart(4, '0').slice(0, 4);
---

<BaseLayout
  title={title}
  description={seoDescription || excerpt}
  articleDate={date}
  articleTags={tags}
  ogImage={cover}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-8 py-10" data-pagefind-body>
    <!-- Belka nawigacyjna powrotu do rejestru -->
    <div class="mb-8 font-mono text-xs text-[var(--color-ink-muted)] flex items-center justify-between border-b border-[var(--color-border)] pb-3">
      <a href={getPostsUrl()} class="inline-flex items-center gap-1.5 hover:text-[var(--color-green)] transition-colors">
        <span aria-hidden="true">←</span>
        <span>[POWRÓT DO REJESTRU WPISÓW]</span>
      </a>
      <div class="flex items-center gap-2 text-[11px]">
        <span class="barcode-strip w-12 h-3 inline-block" aria-hidden="true"></span>
        <span class="text-[var(--color-green)] font-bold">{packetHex}</span>
      </div>
    </div>

    <!-- Nagłówek artykułu — Raport Laboratoryjny / Dossier -->
    <header class="space-y-6 pb-10 border-b border-[var(--color-border)]">
      <!-- Pasek specyfikacji technicznej -->
      <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs border border-[var(--color-border)] bg-[var(--bg-surface)] p-3">
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 bg-[var(--color-green)] inline-block"></span>
          <span class="text-[var(--color-green)] font-bold">[SPEC_SHEET // REPORT_{packetHex}]</span>
          <span class="text-[var(--color-border)]">|</span>
          <time datetime={date.toISOString()} class="text-[var(--color-ink)] font-bold">
            {formattedDate}
          </time>
          {formattedUpdated && (
            <span class="text-[var(--color-ink-muted)] text-[10px]">
              (REV: {formattedUpdated})
            </span>
          )}
        </div>

        <div class="flex items-center gap-2">
          <span class="text-[var(--color-ink-muted)]">READ_BUFFER:</span>
          <span class="text-[var(--color-green)] font-bold">~{readingMinutes}m</span>
        </div>
      </div>

      <!-- Tagi magistrali -->
      <div class="flex flex-wrap gap-1.5 font-mono text-xs">
        {tags.map((t) => (
          <a
            href={getTagUrl(t)}
            class="px-2 py-0.5 border border-[var(--color-border)] text-[11px] text-[var(--color-ink)] hover:border-[var(--color-green)] hover:text-[var(--color-green)] transition-colors bg-[var(--bg-surface)]"
          >
            [JMP_{t.toUpperCase()}] #{tagLabel(t)}
          </a>
        ))}
      </div>

      <!-- Tytuł główny -->
      <h1 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-[var(--color-ink)] tracking-tight leading-[1.08]">
        {title}
      </h1>

      <!-- Wprowadzenie / Lead -->
      <p class="font-body text-xl sm:text-2xl text-[var(--color-ink-muted)] leading-relaxed max-w-3xl pt-1">
        {excerpt}
      </p>

      <!-- Okładka artykułu LUB generatywny motyw ASCII w celownikach -->
      <div class="pt-4">
        {coverMeta ? (
          <div class="terminal-window border border-[var(--color-border)] overflow-hidden bg-[var(--bg-canvas)] corner-brackets relative">
            <div class="absolute top-2 left-3 font-mono text-[9px] text-[var(--color-green)] bg-[var(--bg-canvas)]/90 px-1.5 py-0.5 z-10 border border-[var(--color-border)]" aria-hidden="true">
              PAYLOAD_OPTIC // CALIB: {packetHex}
            </div>
            <Image
              src={coverMeta}
              alt={coverAlt || title}
              widths={[640, 1024, 1600]}
              sizes="(max-width: 1024px) 100vw, 1024px"
              format="webp"
              class="w-full h-auto max-h-[520px] object-cover"
            />
          </div>
        ) : (
          <div class="terminal-window border border-[var(--color-border)] bg-[var(--bg-surface)] p-4 sm:p-6 overflow-hidden flex items-center justify-center corner-brackets">
            <AsciiArt seed={asciiSeed} cols={64} rows={14} style="contour-mesh" themeColor="green" />
          </div>
        )}
      </div>
    </header>

    <!-- Spis treści dla dłuższych artykułów (Symbol Table) -->
    {hasToc && (
      <aside class="my-8 max-w-2xl mx-auto p-4 sm:p-5 border border-[var(--color-border)] bg-[var(--bg-surface)] font-mono text-xs corner-brackets">
        <div class="font-bold text-[var(--color-green)] uppercase tracking-wider mb-3 flex items-center gap-2 border-b border-[var(--color-border)] pb-2">
          <span class="w-2 h-2 bg-[var(--color-green)] inline-block"></span>
          <span>[SYMBOL_TABLE // SPIS SEKTORÓW TREŚCI]</span>
        </div>
        <nav aria-label="Spis treści artykułu">
          <ul class="space-y-1.5">
            {headings
              .filter((h) => h.depth <= 3)
              .map((h) => (
                <li class={h.depth === 3 ? 'pl-4 text-[var(--color-ink-muted)]' : 'font-medium'}>
                  <a href={`#${h.slug}`} class="hover:text-[var(--color-green)] transition-colors">
                    -> {h.text}
                  </a>
                </li>
              ))}
          </ul>
        </nav>
      </aside>
    )}

    <!-- Główna treść artykułu (Czytelna kolumna measure 65-75 znaków) -->
    <div class="py-8">
      <!-- Standardowy Markdown z pliku (jeśli istnieje) -->
      <div class="prose-journal max-w-2xl mx-auto">
        <Content />
      </div>

      <!-- Sekcje multimedialne (Blocks z Pages CMS) -->
      {blocks.length > 0 && (
        <div class="article-blocks space-y-8 my-8">
          {blocks.map((block) => (
            <BlockRenderer block={block} />
          ))}
        </div>
      )}
    </div>

    <!-- Nawigacja poprzedni / następny sektor pamięci -->
    <footer class="mt-16 pt-8 border-t border-[var(--color-border)] font-mono text-xs">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          {prevPost ? (
            <a
              href={getPostUrl(prevPost.data.slug)}
              class="block p-4 border border-[var(--color-border)] hover:border-[var(--color-green)] bg-[var(--bg-surface)] transition-colors group"
            >
              <div class="text-[10px] text-[var(--color-ink-muted)] uppercase mb-1">← [PREV_SECTOR]</div>
              <div class="font-display font-bold text-sm text-[var(--color-ink)] group-hover:text-[var(--color-green)] transition-colors">
                {prevPost.data.title}
              </div>
            </a>
          ) : (
            <div class="p-4 border border-dashed border-[var(--color-border)] text-[var(--color-ink-muted)]">
              [BOF: POCZĄTEK ARCHIWUM]
            </div>
          )}
        </div>

        <div>
          {nextPost ? (
            <a
              href={getPostUrl(nextPost.data.slug)}
              class="block p-4 border border-[var(--color-border)] hover:border-[var(--color-green)] bg-[var(--bg-surface)] transition-colors group sm:text-right"
            >
              <div class="text-[10px] text-[var(--color-ink-muted)] uppercase mb-1">[NEXT_SECTOR] →</div>
              <div class="font-display font-bold text-sm text-[var(--color-ink)] group-hover:text-[var(--color-green)] transition-colors">
                {nextPost.data.title}
              </div>
            </a>
          ) : (
            <div class="p-4 border border-dashed border-[var(--color-border)] text-[var(--color-ink-muted)] sm:text-right">
              [EOF: NAJNOWSZY ZAPIS W REJESTRZE]
            </div>
          )}
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
