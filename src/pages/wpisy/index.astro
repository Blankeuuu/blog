---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/articles/PostCard.astro';
import EmptyState from '../../components/editorial/EmptyState.astro';
import { getPublishedPosts } from '../../lib/posts';
import { TAGS } from '../../data/tags.mjs';
import { getTagUrl } from '../../lib/urls';

const posts = await getPublishedPosts();
const hasPosts = posts.length > 0;
---

<BaseLayout
  title="Wszystkie wpisy"
  description="Pełna lista artykułów, notatek technicznych i devlogów Szymona Potyry."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-12">
    <!-- Nagłówek sekcji w stylu zine -->
    <header class="border-b-2 border-[var(--color-blue)] pb-6 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-magenta)]">
          <span class="inline-block w-2.5 h-2.5 bg-[var(--color-magenta)]"></span>
          <span>[INDEKS / WYDANIA]</span>
        </div>
        <h1 class="font-display font-black text-4xl sm:text-5xl text-[var(--color-ink)] tracking-tight mt-1">
          Wszystkie wpisy
        </h1>
      </div>

      <div class="flex items-center gap-4 font-mono text-xs">
        <span class="text-[var(--color-ink-muted)]">LICZBA WPISÓW: <strong>{posts.length}</strong></span>
        <button
          type="button"
          data-search-trigger
          class="px-3 py-1.5 border border-[var(--color-border)] hover:bg-[var(--color-accent-soft)] text-[var(--color-blue)] transition-colors flex items-center gap-1.5"
        >
          <span>SZUKAJ</span>
          <kbd class="text-[9px] px-1 border border-[var(--color-border)]">Ctrl+K</kbd>
        </button>
      </div>
    </header>

    <!-- Filtry tagów -->
    <nav aria-label="Filtry tagów" class="mb-10 flex flex-wrap gap-2 font-mono text-xs">
      <span class="py-1 text-[var(--color-ink-muted)] mr-2">FILTRUJ:</span>
      {TAGS.map((t) => (
        <a
          href={getTagUrl(t.slug)}
          class="px-2.5 py-1 border border-[var(--color-border)] bg-[var(--bg-paper)] text-[var(--color-ink)] hover:border-[var(--color-magenta)] hover:text-[var(--color-magenta)] transition-colors"
        >
          #{t.short} {t.label}
        </a>
      ))}
    </nav>

    <!-- Lista wpisów -->
    {hasPosts ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {posts.map((post, idx) => (
          <PostCard
            post={post}
            index={idx + 1}
            featured={idx === 0 && post.data.featured}
          />
        ))}
      </div>
    ) : (
      <EmptyState />
    )}
  </div>
</BaseLayout>
