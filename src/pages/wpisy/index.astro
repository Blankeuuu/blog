---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/articles/PostCard.astro';
import EmptyState from '../../components/editorial/EmptyState.astro';
import { getPublishedPosts } from '../../lib/posts';
import { TAGS } from '../../data/tags.mjs';
import { getTagUrl } from '../../lib/urls';

const posts = await getPublishedPosts();
const hasPosts = posts.length > 0;
---

<BaseLayout
  title="Rejestr pakietów"
  description="Pełny rejestr zrzutów pamięci, notatek technicznych i devlogów Szymona Potyry."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-12">
    <!-- Nagłówek sekcji w stylu rejestru laboratoryjnego -->
    <header class="border-b border-[var(--color-border)] pb-6 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 font-mono text-xs text-[var(--color-green)] mb-1">
          <span class="inline-block w-2.5 h-2.5 bg-[var(--color-green)]"></span>
          <span>[STREAM_INDEX // WSZYSTKIE PAKIETY DANYCH]</span>
        </div>
        <h1 class="font-display font-black text-4xl sm:text-5xl text-[var(--color-ink)] tracking-tight">
          Rejestr wpisów
        </h1>
      </div>

      <div class="flex items-center gap-4 font-mono text-xs">
        <span class="text-[var(--color-ink-muted)]">REKORDY: <strong class="text-[var(--color-green)]">{posts.length}</strong></span>
        <button
          type="button"
          data-search-trigger
          class="px-3 py-1.5 border border-[var(--color-border)] hover:border-[var(--color-green)] hover:text-[var(--color-green)] text-[var(--color-ink)] transition-colors flex items-center gap-1.5 bg-[var(--bg-surface)]"
        >
          <span>[CMD: SZUKAJ]</span>
          <kbd class="text-[9px] px-1 border border-[var(--color-border)]">^K</kbd>
        </button>
      </div>
    </header>

    <!-- Zworki magistrali / Filtry tagów -->
    <nav aria-label="Filtry tagów" class="mb-10 flex flex-wrap gap-2 font-mono text-xs">
      <span class="py-1 text-[var(--color-ink-muted)] mr-2">[FILTRUJ MAGISTRALĘ]:</span>
      {TAGS.map((t) => (
        <a
          href={getTagUrl(t.slug)}
          class="px-2.5 py-1 border border-[var(--color-border)] bg-[var(--bg-surface)] text-[var(--color-ink)] hover:border-[var(--color-green)] hover:text-[var(--color-green)] transition-colors"
        >
          [JMP_{t.short.toUpperCase()}] {t.label}
        </a>
      ))}
    </nav>

    <!-- Lista wpisów -->
    {hasPosts ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {posts.map((post, idx) => (
          <PostCard
            post={post}
            index={idx + 1}
            featured={idx === 0 && post.data.featured}
          />
        ))}
      </div>
    ) : (
      <EmptyState />
    )}
  </div>
</BaseLayout>
