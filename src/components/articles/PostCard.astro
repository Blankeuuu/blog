---
import { Image } from 'astro:assets';
import type { PostData } from '../../lib/schema';
import { getPostUrl, getTagUrl } from '../../lib/urls';
import { tagLabel } from '../../data/tags.mjs';
import { resolveImage } from '../../lib/images';
import AsciiArt from '../ascii/AsciiArt.astro';

interface Props {
  post: {
    id: string;
    data: PostData;
  };
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 1 } = Astro.props;
const { title, slug, excerpt, date, tags = [], cover, coverAlt, seed } = post.data;

const formattedDate = new Intl.DateTimeFormat('pl-PL', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date);

const postUrl = getPostUrl(slug);
const coverMeta = cover ? await resolveImage(cover) : null;
const asciiSeed = seed || slug;
const issueNum = String(index).padStart(2, '0');

// Generuj prosty deterministyczny checksum hex dla klimatu sprzętowego
let hash = 0;
for (let i = 0; i < slug.length; i++) {
  hash = (hash << 5) - hash + slug.charCodeAt(i);
  hash |= 0;
}
const packetHex = '0x' + Math.abs(hash).toString(16).toUpperCase().padStart(4, '0').slice(0, 4);
---

<article
  class:list={[
    'terminal-window group relative p-4 sm:p-6 flex flex-col justify-between transition-all duration-200 border border-[var(--color-border)] hover:border-[var(--color-green)] hover:shadow-[4px_4px_0_rgba(0,255,102,0.35)] bg-[var(--bg-surface)] corner-brackets',
    featured ? 'lg:col-span-2' : '',
  ]}
>
  <div>
    <!-- Górny pas biletowy: Kod kreskowy, numer pakietu, data, status -->
    <div class="flex flex-wrap items-center justify-between border-b border-[var(--color-border)] pb-3 mb-4 font-mono text-xs gap-2">
      <div class="flex items-center gap-2">
        <span class="barcode-strip w-14 h-3 inline-block" aria-hidden="true"></span>
        <span class="font-bold text-[var(--color-green)]">#DEV-{issueNum}</span>
        <span class="text-[var(--color-border)]">/</span>
        <span class="text-[var(--color-ink-muted)] text-[11px]">{packetHex}</span>
      </div>

      <div class="flex items-center gap-2">
        <time datetime={date.toISOString()} class="text-[var(--color-ink-muted)] text-[11px]">
          {formattedDate}
        </time>
        <span class="px-1.5 py-0.2 border border-[var(--color-green)] text-[var(--color-green)] text-[9px] font-bold">
          STATUS: OK
        </span>
      </div>
    </div>

    <!-- Miniatura okładki LUB deterministyczna matryca ASCII artykułu -->
    <div class="mb-4 overflow-hidden border border-[var(--color-border)] bg-[var(--bg-canvas)] relative">
      <div class="absolute top-1 left-2 font-mono text-[8px] text-[var(--color-ink-muted)] z-10 bg-[var(--bg-canvas)]/80 px-1" aria-hidden="true">
        CALIB: {packetHex} // {slug.slice(0, 16)}
      </div>

      {coverMeta ? (
        <Image
          src={coverMeta}
          alt={coverAlt || title}
          widths={[480, 800, 1200]}
          sizes={featured ? '(max-width: 1024px) 100vw, 800px' : '(max-width: 640px) 100vw, 400px'}
          format="webp"
          class="w-full h-44 sm:h-52 object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      ) : (
        <div class="h-36 sm:h-44 flex items-center justify-center p-2 bg-[var(--bg-canvas)]">
          <AsciiArt seed={asciiSeed} cols={44} rows={11} style="thumbnail" themeColor="green" />
        </div>
      )}
    </div>

    <!-- Tagi zworkowe -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {tags.slice(0, 3).map((t) => (
        <a
          href={getTagUrl(t)}
          class="text-[10px] font-mono px-1.5 py-0.5 border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:border-[var(--color-green)] hover:text-[var(--color-green)] transition-colors"
        >
          [JMP_{t.toUpperCase()}] {tagLabel(t)}
        </a>
      ))}
    </div>

    <!-- Tytuł wpisu -->
    <h3 class:list={[
      'font-display font-black tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-green)] transition-colors',
      featured ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl',
    ]}>
      <a href={postUrl} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <!-- Zajawka / zrzut treści -->
    <p class="mt-2.5 font-body text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed line-clamp-3">
      {excerpt}
    </p>
  </div>

  <!-- Dolna perforacja biletu i akcja odczytu -->
  <div class="mt-6 pt-3 border-t border-dashed border-[var(--color-border)] flex items-center justify-between font-mono text-xs">
    <a
      href={postUrl}
      class="inline-flex items-center gap-1.5 font-bold text-[var(--color-green)] hover:text-white transition-colors"
      aria-label={`Czytaj bufor wpisu: ${title}`}
    >
      <span>[READ_BUFFER_STREAM]</span>
      <span aria-hidden="true">→</span>
    </a>
    <span class="text-[9px] text-[var(--color-ink-muted)]">CRC32: {packetHex}</span>
  </div>
</article>
