---
import { Image } from 'astro:assets';
import type { PostData } from '../../lib/schema';
import { getPostUrl, getTagUrl } from '../../lib/urls';
import { tagLabel } from '../../data/tags.mjs';
import { resolveImage } from '../../lib/images';
import AsciiArt from '../ascii/AsciiArt.astro';

interface Props {
  post: {
    id: string;
    data: PostData;
  };
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 1 } = Astro.props;
const { title, slug, excerpt, date, tags = [], cover, coverAlt, seed } = post.data;

const formattedDate = new Intl.DateTimeFormat('pl-PL', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date);

const postUrl = getPostUrl(slug);
const coverMeta = cover ? await resolveImage(cover) : null;
const asciiSeed = seed || slug;
const issueNum = String(index).padStart(2, '0');

// Generuj prosty deterministyczny checksum hex dla klimatu sprzętowego
let hash = 0;
for (let i = 0; i < slug.length; i++) {
  hash = (hash << 5) - hash + slug.charCodeAt(i);
  hash |= 0;
}
const packetHex = '0x' + Math.abs(hash).toString(16).toUpperCase().padStart(4, '0').slice(0, 4);
const isEven = index % 2 === 0;
---

<article
  class:list={[
    'shard-box group relative p-5 sm:p-7 flex flex-col justify-between transition-all duration-200 border-2 border-[var(--color-border)] hover:border-[var(--color-blood)] hover:shadow-[6px_6px_0_var(--color-blood)] bg-[var(--bg-shard)] crosshair-corners select-none',
    isEven ? 'hover:rotate-0.5' : 'hover:-rotate-0.5',
    featured ? 'lg:col-span-2' : '',
  ]}
>
  <div>
    <!-- Górna taśma: Kod kreskowy, identyfikator DEV.xx (bez '#'), data i mrówka -->
    <div class="flex flex-wrap items-center justify-between border-b border-[var(--color-border)] pb-3 mb-4 font-mono text-xs gap-2">
      <div class="flex items-center gap-2.5">
        <span class="barcode-dense w-12 h-3.5 inline-block" aria-hidden="true"></span>
        <span class="font-black text-[var(--color-blood)] tracking-wider">DEV.{issueNum}</span>
        <span class="text-[var(--color-border)]">/</span>
        <span class="text-[var(--color-ink-muted)] text-[11px]">{packetHex}</span>
      </div>

      <div class="flex items-center gap-2 font-mono text-[11px]">
        <time datetime={date.toISOString()} class="text-[var(--color-ink-muted)]">
          {formattedDate}
        </time>
      </div>
    </div>

    <!-- Miniatura okładki LUB deterministyczna matryca ASCII (w celownikach) -->
    <div class="mb-4 overflow-hidden border border-[var(--color-border)] bg-black relative">

      {coverMeta ? (
        <Image
          src={coverMeta}
          alt={coverAlt || title}
          widths={[480, 800, 1200]}
          sizes={featured ? '(max-width: 1024px) 100vw, 800px' : '(max-width: 640px) 100vw, 400px'}
          format="webp"
          class="w-full h-44 sm:h-52 object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        />
      ) : (
        <div class="h-36 sm:h-44 flex items-center justify-center p-2 bg-black">
          <AsciiArt seed={asciiSeed} cols={44} rows={11} style="glitch" themeColor="red" />
        </div>
      )}
    </div>

    <!-- Tagi bez znaku '#' (Zgodnie z wytycznymi użytkownika) -->
    <div class="flex flex-wrap gap-1.5 mb-3 font-mono text-xs">
      {tags.slice(0, 3).map((t) => (
        <a
          href={getTagUrl(t)}
          class="text-[10px] px-2 py-0.5 border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:border-[var(--color-blood)] hover:text-[var(--color-blood)] hover:bg-[var(--bg-void)] transition-colors font-bold uppercase tracking-wider"
        >
          {tagLabel(t)}
        </a>
      ))}
    </div>

    <!-- Tytuł wpisu (Rozciągnięty, brutalistyczny) -->
    <h3 class:list={[
      'font-display font-black tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-blood)] transition-colors',
      featured ? 'text-2xl sm:text-3xl lg:text-4xl' : 'text-xl sm:text-2xl',
    ]}>
      <a href={postUrl} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <!-- Zajawka / Zrzut tekstu -->
    <p class="mt-2.5 font-body text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed line-clamp-3">
      {excerpt}
    </p>
  </div>

  <!-- Dolny pas akcji: Czerwona laserowa perforacja i CRC -->
  <div class="mt-6 pt-3 border-t border-[var(--color-border)] flex items-center justify-between font-mono text-xs">
    <a
      href={postUrl}
      class="inline-flex items-center gap-1.5 font-black text-[var(--color-blood)] hover:text-white transition-colors tracking-wider"
      aria-label={`Czytaj wpis: ${title}`}
    >
      <span>CZYTAJ WPIS</span>
      <span aria-hidden="true">→</span>
    </a>
    <span class="text-[9px] text-[var(--color-ink-muted)]">CRC: {packetHex}</span>
  </div>
</article>
