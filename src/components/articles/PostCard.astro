---
import { Image } from 'astro:assets';
import type { PostData } from '../../lib/schema';
import { getPostUrl, getTagUrl } from '../../lib/urls';
import { tagLabel } from '../../data/tags.mjs';
import { resolveImage } from '../../lib/images';
import AsciiArt from '../ascii/AsciiArt.astro';

interface Props {
  post: {
    id: string;
    data: PostData;
  };
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 1 } = Astro.props;
const { title, slug, excerpt, date, tags = [], cover, coverAlt, seed } = post.data;

const formattedDate = new Intl.DateTimeFormat('pl-PL', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(date);

const postUrl = getPostUrl(slug);
const coverMeta = cover ? await resolveImage(cover) : null;
const asciiSeed = seed || slug;
const issueNum = String(index).padStart(2, '0');
---

<article
  class:list={[
    'group relative border-2 border-[var(--color-border)] bg-[var(--color-card)] p-5 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:border-[var(--color-magenta)] hover:shadow-[4px_4px_0_var(--color-blue)]',
    featured ? 'lg:col-span-2' : '',
  ]}
>
  <div>
    <!-- Górny pasek metadanych: Numer wydania, data, tagi -->
    <div class="flex items-center justify-between border-b border-[var(--color-border)] pb-3 mb-4 font-mono text-xs">
      <div class="flex items-center gap-2">
        <span class="font-bold text-[var(--color-magenta)]">#{issueNum}</span>
        <span class="text-[var(--color-ink-muted)]">/</span>
        <time datetime={date.toISOString()} class="text-[var(--color-ink-muted)]">
          {formattedDate}
        </time>
      </div>

      <!-- Tagi -->
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((t) => (
          <a
            href={getTagUrl(t)}
            class="text-[10px] px-1.5 py-0.5 border border-[var(--color-border)] text-[var(--color-blue)] hover:bg-[var(--color-blue)] hover:text-white transition-colors"
          >
            {tagLabel(t)}
          </a>
        ))}
      </div>
    </div>

    <!-- Miniatura okładki LUB generatywny motyw ASCII -->
    <div class="mb-5 overflow-hidden border border-[var(--color-border)] bg-[var(--color-grid)]">
      {coverMeta ? (
        <Image
          src={coverMeta}
          alt={coverAlt || title}
          widths={[480, 800, 1200]}
          sizes={featured ? '(max-width: 1024px) 100vw, 800px' : '(max-width: 640px) 100vw, 400px'}
          format="webp"
          class="w-full h-48 sm:h-56 object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="h-40 sm:h-48 flex items-center justify-center p-2 bg-[var(--bg-paper)]">
          <AsciiArt seed={asciiSeed} cols={44} rows={12} style="thumbnail" themeColor="blue" />
        </div>
      )}
    </div>

    <!-- Tytuł wpisu -->
    <h3 class:list={[
      'font-display font-black tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-blue)] transition-colors',
      featured ? 'text-2xl sm:text-3xl lg:text-4xl' : 'text-xl sm:text-2xl',
    ]}>
      <a href={postUrl} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <!-- Krótki opis / zajawka -->
    <p class="mt-3 font-body text-sm sm:text-base text-[var(--color-ink-muted)] leading-relaxed line-clamp-3">
      {excerpt}
    </p>
  </div>

  <!-- Dolny pasek czytania -->
  <div class="mt-6 pt-4 border-t border-[var(--color-border)] flex items-center justify-between font-mono text-xs">
    <a
      href={postUrl}
      class="inline-flex items-center gap-1.5 font-bold text-[var(--color-blue)] group-hover:text-[var(--color-magenta)] transition-colors"
      aria-label={`Czytaj wpis: ${title}`}
    >
      <span>CZYTAJ WPIS</span>
      <span aria-hidden="true">→</span>
    </a>
    <span class="text-[10px] text-[var(--color-ink-muted)]">REF: {slug}</span>
  </div>
</article>
