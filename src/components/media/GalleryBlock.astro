---
import ImageBlock from './ImageBlock.astro';

interface GalleryItem {
  image: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryItem[];
  caption?: string;
}

const { images = [], caption } = Astro.props;
const count = images.length;

// Asymetryczna kompozycja w zależności od liczby zdjęć
const gridCols =
  count === 1
    ? 'grid-cols-1'
    : count === 2
    ? 'grid-cols-1 sm:grid-cols-2'
    : count === 3
    ? 'grid-cols-1 sm:grid-cols-3'
    : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
---

<section class="my-12 max-w-5xl mx-auto" aria-label="Galeria zdjęć">
  <div class:list={['grid gap-4 sm:gap-6', gridCols]}>
    {images.map((item, idx) => (
      <div class="relative">
        <span class="absolute top-2 left-2 z-10 font-mono text-[9px] bg-[var(--bg-canvas)]/90 px-1 py-0.5 border border-[var(--color-border)] text-[var(--color-green)]">
          FRAME_{String(idx + 1).padStart(2, '0')}
        </span>
        <ImageBlock image={item.image} alt={item.alt} caption={item.caption} width="tekst" />
      </div>
    ))}
  </div>
  {caption && (
    <div class="mt-3 text-center text-xs font-mono text-[var(--color-ink-muted)]">
      <span class="text-[var(--color-green)] font-bold">[PANEL_MATRIX]</span> {caption}
    </div>
  )}
</section>
