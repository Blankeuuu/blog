---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';
import { resolvePath } from '../../lib/urls';

interface Props {
  image: string;
  alt: string;
  caption?: string;
  width?: 'tekst' | 'szeroki' | 'pelny';
}

const { image, alt, caption, width = 'szeroki' } = Astro.props;

const imageMeta = await resolveImage(image);
const fallbackSrc = image.startsWith('/') ? resolvePath(image) : image;

const containerWidth =
  width === 'tekst'
    ? 'max-w-2xl mx-auto'
    : width === 'pelny'
    ? 'w-full max-w-7xl mx-auto'
    : 'max-w-5xl mx-auto';
---

<figure class:list={['my-8', containerWidth]}>
  <div class="terminal-window relative overflow-hidden border border-[var(--color-border)] bg-[var(--bg-canvas)] group corner-brackets">
    <!-- Etykieta kalibracji obrazu (z referencji 3) -->
    <div class="absolute top-2 left-2 z-10 font-mono text-[9px] text-[var(--color-green)] bg-[var(--bg-canvas)]/85 px-1.5 py-0.5 border border-[var(--color-border)]" aria-hidden="true">
      FRAME_OPTIC // CALIB: 58.64896, -146.83960
    </div>

    {imageMeta ? (
      <Image
        src={imageMeta}
        alt={alt}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="(max-width: 640px) 100vw, (max-width: 1280px) 90vw, 1280px"
        format="webp"
        quality={88}
        class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-[1.01]"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <img
        src={fallbackSrc}
        alt={alt}
        class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-[1.01]"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  {caption && (
    <figcaption class="mt-2 text-xs font-mono text-[var(--color-ink-muted)] flex items-center gap-2">
      <span class="text-[var(--color-green)] font-bold">[FIG_FRAME]</span>
      <span>{caption}</span>
    </figcaption>
  )}
</figure>
