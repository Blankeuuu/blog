---
import { Code } from 'astro/components';

interface Props {
  code: string;
  language?: string;
  filename?: string;
}

const { code = '', language = 'text', filename } = Astro.props;

// Mapowanie języków dla Shiki
const lang = language === 'text' ? 'plaintext' : language;
---

<div class="my-8 max-w-4xl mx-auto shard-box overflow-hidden border-2 border-[var(--color-blood)]/70 bg-[#05060a]">
  <!-- Belka nagłówka kodu: Retro OS Serial Experiments Lain / Breakcore dump bar -->
  <div class="flex items-center justify-between px-3 sm:px-4 py-2 bg-[var(--bg-void)] border-b border-[var(--color-blood)]/50 font-mono text-xs">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 bg-[var(--color-blood)] animate-pulse"></span>
      {filename ? (
        <span class="font-black text-[var(--color-ink)]">{filename}</span>
      ) : (
        <span class="text-[var(--color-blood)] font-bold">CODE</span>
      )}
      <span class="text-[10px] uppercase px-1.5 py-0.5 bg-[var(--bg-shard)] border border-[var(--color-border)] text-[var(--color-acid)] font-bold">
        {language}
      </span>
      <span class="hidden sm:inline text-[9px] text-[var(--color-ink-muted)]">
        OFFSET: 0x0000
      </span>
    </div>

    <!-- Przyciski i kopiowanie -->
    <div class="flex items-center gap-3">
      <button
        type="button"
        class="copy-code-btn px-2.5 py-0.5 border border-[var(--color-blood)] text-[var(--color-blood)] hover:bg-[var(--color-blood)] hover:text-black transition-all text-[10px] font-black uppercase bg-[var(--bg-shard)]"
        data-code={code}
        aria-label="Kopiuj zawartość bufora do schowka"
      >
        KOPIUJ
      </button>
    </div>
  </div>

  <!-- Zawartość kodu w stylizacji debugera -->
  <div class="p-4 overflow-x-auto text-xs sm:text-sm font-mono leading-relaxed bg-[#030407]">
    <Code code={code} lang={lang as any} theme="github-dark-dimmed" />
  </div>
</div>

<script>
  import { playBleep } from '../../lib/audio';

  function initCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.code || '';
        try {
          await navigator.clipboard.writeText(text);
          playBleep(1200, 0.05);
          const original = btn.textContent;
          btn.textContent = 'SKOPIOWANO ✓';
          btn.classList.add('bg-[var(--color-blood)]', 'text-black');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('bg-[var(--color-blood)]', 'text-black');
          }, 2000);
        } catch (err) {
          console.error('Błąd kopiowania:', err);
        }
      });
    });
  }

  if (typeof document !== 'undefined') {
    initCopyButtons();
    document.addEventListener('astro:page-load', initCopyButtons);
  }
</script>
