---
import AsciiArt from '../ascii/AsciiArt.astro';
import { SITE } from '../../lib/urls';

interface Props {
  message?: string;
  isTagFilter?: boolean;
}

const { message, isTagFilter = false } = Astro.props;
---

<section class="my-12 max-w-4xl mx-auto shard-box border-2 border-[var(--color-blood)] bg-[var(--bg-shard)] p-6 sm:p-10 relative overflow-hidden crosshair-corners transform rotate-[-0.5deg] shadow-[8px_8px_0_rgba(255,0,60,0.3)]">
  <!-- Pasek tytułowy okna zakłóceń -->
  <div class="flex items-center justify-between border-b border-[var(--color-blood)] pb-3 mb-6 font-mono text-xs">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 bg-[var(--color-blood)] inline-block animate-ping"></span>
      <span class="text-[var(--color-blood)] font-black tracking-widest">
        {isTagFilter ? 'STATUS // PUSTY WYNIK' : 'STATUS // BRAK WPISÓW'}
      </span>
    </div>
    <div class="flex items-center gap-2 text-[10px] text-[var(--color-ink-muted)]">
      <span>_</span>
      <span>[]</span>
      <span>X</span>
    </div>
  </div>

  <!-- ŚCIANA SZUMU I ZAKŁÓCEŃ (Static Noise Wall) -->
  <div class="my-6 border border-[var(--color-blood)] bg-black p-4 overflow-hidden flex items-center justify-center relative">
    <div class="absolute top-2 left-3 font-mono text-[9px] text-[var(--color-blood)] z-10 bg-black/90 px-1.5 py-0.5 border border-[var(--color-blood)]" aria-hidden="true">
      STATIC NOISE // 100%
    </div>
    <AsciiArt seed="empty-static-noise-wall" cols={54} rows={12} style="dither-cluster" themeColor="red" />
  </div>

  <!-- Komunikat statusu -->
  <div class="bg-black/90 border border-[var(--color-border)] p-4 font-mono text-xs space-y-2 mb-6">
    <div class="text-[var(--color-blood)] font-bold">
      [0.000000] STATUS: BUFFER_EMPTY
    </div>
    <div class="text-[var(--color-ink-muted)] text-xs leading-relaxed">
      {message || 'Brak opublikowanych wpisów w tym widoku. Nowe publikacje pojawią się wkrótce.'}
    </div>
  </div>

  <!-- Przyciski wykonawcze -->
  <div class="pt-4 border-t border-[var(--color-border)] flex flex-wrap gap-4 font-mono text-xs">
    <a
      href="https://app.pagescms.org/"
      target="_blank"
      rel="noopener noreferrer"
      class="px-5 py-2.5 bg-[var(--color-blood)] text-black font-black hover:bg-white hover:text-black transition-all shadow-[3px_3px_0_white]"
    >
      PAGES CMS ↗
    </a>
    <a
      href={SITE.portfolio}
      target="_blank"
      rel="noopener noreferrer"
      class="px-4 py-2.5 border border-[var(--color-border)] text-[var(--color-ink)] hover:border-[var(--color-blood)] hover:text-[var(--color-blood)] transition-colors"
    >
      PORTFOLIO ↗
    </a>
  </div>
</section>
