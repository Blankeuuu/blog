---
import AsciiArt from '../ascii/AsciiArt.astro';
import { SITE, getArchiveUrl, getPostsUrl, getTagUrl } from '../../lib/urls';
import { TAGS } from '../../data/tags.mjs';

interface Props {
  totalPosts?: number;
}

const { totalPosts = 0 } = Astro.props;
---

<section class="relative min-h-[85vh] sm:min-h-[90vh] border-b-2 border-[var(--color-blue)] bg-grid-paper overflow-hidden flex flex-col justify-between p-4 sm:p-8 lg:p-12">
  <!-- Ozdobne narożniki drukarskie (crop marks) -->
  <div class="pointer-events-none absolute top-3 left-3 font-mono text-[9px] text-[var(--color-blue)] opacity-60" aria-hidden="true">
    +-- TOP:LEFT [REV.2026]
  </div>
  <div class="pointer-events-none absolute top-3 right-3 font-mono text-[9px] text-[var(--color-magenta)] opacity-60" aria-hidden="true">
    [BLANKEU//SYS] --+
  </div>

  <!-- Główna kompozycja plakatu (Grid asymetryczny) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center my-auto z-10 pt-4">
    <!-- Lewa kolumna: Ogromna typografia plakatu, nadruki riso, autor -->
    <div class="lg:col-span-7 space-y-6">
      <div class="inline-flex items-center gap-2 px-2 py-1 border border-[var(--color-blue)] bg-[var(--bg-paper)] font-mono text-xs text-[var(--color-blue)]">
        <span class="w-2 h-2 bg-[var(--color-magenta)] inline-block"></span>
        <span>SZYMON POTYRA // EXPERIMENTAL JOURNAL</span>
      </div>

      <!-- Tytuł główny: Ogromny, przycięty napis BLANKEU -->
      <div class="relative">
        <h1 class="font-display font-black text-6xl sm:text-8xl xl:text-9xl tracking-tighter leading-[0.88] text-[var(--color-ink)] select-none">
          <span class="block hover:text-[var(--color-magenta)] transition-colors duration-300">
            {SITE.wordmark}
          </span>
          <span class="block text-[var(--color-blue)] text-4xl sm:text-6xl xl:text-7xl font-stretch-75 tracking-normal mt-2">
            DEVLOG / 2026
          </span>
        </h1>

        <!-- Nakładka w stylu risograph (przesunięty różowy akcent typograficzny jak na plakacie) -->
        <div class="absolute -top-4 sm:-top-6 right-2 sm:right-12 font-mono text-xs sm:text-sm font-bold text-[var(--color-magenta)] border-2 border-[var(--color-magenta)] px-2 sm:px-3 py-1 bg-[var(--bg-paper)] rotate-3 shadow-[2px_2px_0_var(--color-blue)] pointer-events-none">
          NOTATKI // MAKER // KOD
        </div>
      </div>

      <!-- Manifest i opis -->
      <p class="font-body text-lg sm:text-xl text-[var(--color-ink-muted)] max-w-xl leading-relaxed pt-2">
        Niezależna cyfrowa publikacja: surowe procesy inżynierskie, prototypy urządzeń, agenci programistyczni, projekty CAD, druk 3D oraz refleksje warsztatowe.
      </p>

      <!-- Przyciski wejścia do treści -->
      <div class="flex flex-wrap items-center gap-4 pt-4 font-mono text-xs sm:text-sm">
        <a
          href={getPostsUrl()}
          class="px-6 py-3.5 bg-[var(--color-blue)] text-white font-bold hover:bg-[var(--color-magenta)] transition-colors shadow-[4px_4px_0_var(--color-ink)] inline-flex items-center gap-2"
        >
          <span>PRZEGLĄDAJ WPISY</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href={getArchiveUrl()}
          class="px-6 py-3.5 border-2 border-[var(--color-ink)] text-[var(--color-ink)] hover:border-[var(--color-blue)] hover:text-[var(--color-blue)] transition-colors bg-[var(--bg-paper)]"
        >
          PEŁNE ARCHIWUM ({totalPosts})
        </a>

        <button
          type="button"
          data-search-trigger
          class="px-4 py-3.5 border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:text-[var(--color-magenta)] transition-colors"
          title="Otwórz wyszukiwarkę"
        >
          SZUKAJ [Ctrl+K]
        </button>
      </div>
    </div>

    <!-- Prawa kolumna: Generatywne płótno ASCII -->
    <div class="lg:col-span-5 relative">
      <div class="relative border-2 border-[var(--color-blue)] bg-[var(--color-card)] p-4 sm:p-6 shadow-[6px_6px_0_var(--color-magenta)]">
        <!-- Belka informacyjna generatora ASCII -->
        <div class="flex justify-between items-center border-b border-[var(--color-border)] pb-2 mb-3 font-mono text-[10px] text-[var(--color-ink-muted)]">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-blue)]"></span>
            <span>ASCII ENGINE // SEED: BLANKEU</span>
          </div>
          <span>INTERACTIVE</span>
        </div>

        <!-- Generatywne płótno ASCII -->
        <div class="overflow-hidden flex items-center justify-center min-h-[300px] sm:min-h-[380px]">
          <AsciiArt seed="blankeu-hero-master" cols={54} rows={22} style="poster-hero" themeColor="blue" />
        </div>

        <div class="mt-3 pt-2 border-t border-[var(--color-border)] flex justify-between items-center font-mono text-[9px] text-[var(--color-ink-muted)]">
          <span>PROXIMITY FIELD & STRATA MESH</span>
          <span>RISO MATRIX</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Dolny pas: Matryca tematów -->
  <div class="pt-8 mt-6 border-t border-[var(--color-border)] z-10">
    <div class="flex items-center justify-between mb-3 font-mono text-xs text-[var(--color-ink-muted)]">
      <span class="text-[var(--color-blue)] font-bold">[TEMATY PUBLIKACJI]</span>
      <span class="hidden sm:inline">WYBIERZ OBSZAR ABY FILTROWAĆ</span>
    </div>
    <div class="flex flex-wrap gap-2">
      {TAGS.map((t) => (
        <a
          href={getTagUrl(t.slug)}
          class="px-3 py-1 border border-[var(--color-border)] bg-[var(--bg-paper)] font-mono text-xs text-[var(--color-ink)] hover:border-[var(--color-magenta)] hover:text-[var(--color-magenta)] transition-colors"
        >
          <span class="text-[var(--color-blue)] font-bold mr-1">#{t.short}</span>
          <span>{t.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
