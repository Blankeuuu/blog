---
import AsciiArt from '../ascii/AsciiArt.astro';
import { SITE, getArchiveUrl, getPostsUrl, getTagUrl } from '../../lib/urls';
import { TAGS } from '../../data/tags.mjs';

interface Props {
  totalPosts?: number;
}

const { totalPosts = 0 } = Astro.props;
---

<section class="relative min-h-[85vh] sm:min-h-[92vh] border-b border-[var(--color-border)] bg-[var(--bg-canvas)] flex flex-col justify-between p-4 sm:p-8 lg:p-12 overflow-hidden">
  <!-- Górne znaczniki diagnostyczne / celowniki kalibracyjne -->
  <div class="pointer-events-none absolute top-2 left-3 font-mono text-[9px] text-[var(--color-green)] opacity-75" aria-hidden="true">
    ┌── [DECK_ID: 0x4F92] ─────────────────────────── [CALIB: 52.2297N, 21.0122E] ──┐
  </div>
  <div class="pointer-events-none absolute top-2 right-3 font-mono text-[9px] text-[var(--color-red)] opacity-75" aria-hidden="true">
    └── [STATUS: OVERCLOCK] ──┘
  </div>

  <!-- Główna stacja diagnostyczna (Terminal Deck Grid) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch my-auto z-10 pt-6">
    <!-- Lewa konsola: Identyfikator, bilet ostrzegawczy zrzutu pamięci, manifest i przyciski -->
    <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <!-- Pasek procesora / PID -->
        <div class="inline-flex items-center gap-2 px-2.5 py-1 border border-[var(--color-border)] bg-[var(--bg-surface)] font-mono text-xs text-[var(--color-green)]">
          <span class="w-2 h-2 bg-[var(--color-green)] inline-block"></span>
          <span>PID: 0x10FF // SYS_DISPATCH: ACTIVE // {SITE.author.toUpperCase()}</span>
        </div>

        <!-- Tytuł główny: Ogromna typografia terminala inżynieryjnego -->
        <div class="relative">
          <h1 class="font-display font-black text-6xl sm:text-8xl xl:text-9xl tracking-tighter leading-[0.88] text-[var(--color-ink)] select-none">
            <span class="block hover:text-[var(--color-green)] transition-colors duration-300">
              {SITE.wordmark}
            </span>
            <span class="block text-[var(--color-green)] text-3xl sm:text-5xl xl:text-6xl tracking-tight mt-2 font-mono font-bold">
              DEVLOG // KERNEL
            </span>
          </h1>

          <!-- Naklejka / zrzut ostrzegawczy z referencji 1 (Ticket Strip) -->
          <div class="mt-4 border border-[var(--color-red)] bg-[var(--bg-surface)] p-3 text-xs font-mono max-w-lg shadow-[3px_3px_0_var(--color-red)]">
            <div class="flex items-center justify-between border-b border-[var(--color-red)]/40 pb-1.5 mb-1.5 text-[10px]">
              <span class="text-[var(--color-red)] font-bold">[CRASH_DUMP: MEMORY_OVERFLOW]</span>
              <span class="barcode-strip w-16 h-3 inline-block"></span>
              <span class="text-[var(--color-ink-muted)]">REF: 048693048522</span>
            </div>
            <p class="text-[var(--color-red)] text-[11px] leading-tight">
              The system has run out of memory. Discarding unverified hypotheses. Hardware traces, reverse engineering and autonomous agent telemetry dumped to stdout.
            </p>
            <div class="mt-1.5 flex justify-between text-[9px] text-[var(--color-ink-muted)]">
              <span>9:00-18:00 WORK TIME</span>
              <span>MEMORY DUMP: 100%</span>
            </div>
          </div>
        </div>

        <!-- Manifest devloga -->
        <p class="font-body text-base sm:text-lg text-[var(--color-ink-muted)] max-w-xl leading-relaxed pt-1">
          Surowy poligon inżynierski: systemy wbudowane, sterowniki mikrokontrolerów, architektura agentów AI, telemetryczne zrzuty pamięci oraz fizyczne prototypy CAD/3D.
        </p>
      </div>

      <!-- Przyciski wykonawcze terminala (Laboratory Control Knobs) -->
      <div class="flex flex-wrap items-center gap-3 pt-2 font-mono text-xs">
        <a
          href={getPostsUrl()}
          class="px-5 py-3 bg-[var(--color-green)] text-black font-bold hover:bg-white hover:text-black transition-all shadow-[3px_3px_0_rgba(0,255,102,0.4)] inline-flex items-center gap-2"
        >
          <span>[EXECUTE: WPISY]</span>
          <span aria-hidden="true">→</span>
        </a>

        <a
          href={getArchiveUrl()}
          class="px-5 py-3 border border-[var(--color-border)] text-[var(--color-ink)] hover:border-[var(--color-green)] hover:text-[var(--color-green)] bg-[var(--bg-surface)] transition-colors"
        >
          [DUMP: ARCHIWUM ({totalPosts})]
        </a>

        <button
          type="button"
          data-search-trigger
          class="px-4 py-3 border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:border-[var(--color-green)] hover:text-[var(--color-green)] bg-[var(--bg-surface)] transition-colors"
          title="Otwórz wyszukiwarkę w pamięci podręcznej (Ctrl+K)"
        >
          [CMD: ^K SZUKAJ]
        </button>
      </div>
    </div>

    <!-- Prawa konsola: Interaktywny monitor oscyloskopowy ASCII_CORE.v4 -->
    <div class="lg:col-span-5 flex flex-col justify-center">
      <div class="terminal-window border border-[var(--color-border)] bg-[var(--bg-surface)] p-4 sm:p-5 corner-brackets relative">
        <!-- Belka oscyloskopu -->
        <div class="flex justify-between items-center border-b border-[var(--color-border)] pb-2 mb-3 font-mono text-[10px] text-[var(--color-ink-muted)]">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 bg-[var(--color-green)] animate-ping"></span>
            <span class="text-[var(--color-green)] font-bold">ASCII_CORE.v4 // RASTER_OUTPUT</span>
          </div>
          <div class="flex items-center gap-1.5 text-[9px]">
            <span>_</span>
            <span>[]</span>
            <span>X</span>
          </div>
        </div>

        <!-- Matryca ASCII -->
        <div class="overflow-hidden flex items-center justify-center min-h-[290px] sm:min-h-[360px] bg-[var(--bg-canvas)] border border-[var(--color-border)] p-2">
          <AsciiArt seed="blankeu-deck-master" cols={52} rows={21} style="poster-hero" themeColor="green" />
        </div>

        <!-- Dolny panel kontrolny oscyloskopu: sygnatura szumu i stan bufora -->
        <div class="mt-3 pt-2 border-t border-[var(--color-border)] flex flex-wrap justify-between items-center font-mono text-[9px] text-[var(--color-ink-muted)] gap-2">
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-green)] font-bold">MODULATION:</span>
            <span>VALUE_NOISE_2D</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--color-blue)]">FREQ: 14.318MHz</span>
            <span>SEED: 0x9AF4</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dolny pas: Matryca zworek magistrali (Jumper Pins / Tags) -->
  <div class="pt-6 mt-8 border-t border-[var(--color-border)] z-10 font-mono text-xs">
    <div class="flex items-center justify-between mb-3 text-[11px] text-[var(--color-ink-muted)]">
      <div class="flex items-center gap-2">
        <span class="text-[var(--color-green)] font-bold">[BUS_JUMPERS // KATEGORIE TEMATYCZNE]</span>
        <span class="text-[10px] text-[var(--color-border)]">────────</span>
      </div>
      <span class="hidden sm:inline text-[10px]">SELECT PIN TO READ TELEMETRY</span>
    </div>
    <div class="flex flex-wrap gap-2">
      {TAGS.map((t) => (
        <a
          href={getTagUrl(t.slug)}
          class="px-2.5 py-1 border border-[var(--color-border)] bg-[var(--bg-surface)] text-[11px] text-[var(--color-ink)] hover:border-[var(--color-green)] hover:text-[var(--color-green)] transition-all flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 bg-[var(--color-green)] inline-block"></span>
          <span class="text-[var(--color-ink-muted)]">JMP_{t.short.toUpperCase()}:</span>
          <span>{t.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
