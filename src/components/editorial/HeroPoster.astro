---
import AsciiArt from '../ascii/AsciiArt.astro';
import { SITE, getArchiveUrl, getPostsUrl, getTagUrl } from '../../lib/urls';
import { TAGS } from '../../data/tags.mjs';

interface Props {
  totalPosts?: number;
}

const { totalPosts = 0 } = Astro.props;
---

<section class="relative min-h-[90vh] border-b-2 border-[var(--color-blood)] bg-[var(--bg-void)] flex flex-col justify-between p-4 sm:p-8 lg:p-12 overflow-hidden select-none">
  <!-- Wektorowe czerwone promienie laserowe -->
  <div class="pointer-events-none absolute inset-0 z-0 opacity-30" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <line x1="95%" y1="6%" x2="0%" y2="15%" stroke="var(--color-blood)" stroke-width="1.5" />
      <line x1="95%" y1="6%" x2="0%" y2="45%" stroke="var(--color-blood)" stroke-width="1.5" />
      <line x1="95%" y1="6%" x2="10%" y2="85%" stroke="var(--color-blood)" stroke-width="1.5" />
      <line x1="95%" y1="6%" x2="30%" y2="100%" stroke="var(--color-blood)" stroke-width="1.5" />
      <line x1="95%" y1="6%" x2="60%" y2="100%" stroke="var(--color-blood)" stroke-width="1.5" />
      <line x1="95%" y1="6%" x2="85%" y2="100%" stroke="var(--color-blood)" stroke-width="1.5" stroke-dasharray="8 4" />
      <rect x="15%" y="24%" width="140" height="90" fill="none" stroke="var(--color-blood)" stroke-width="1" />
      <rect x="70%" y="65%" width="110" height="70" fill="none" stroke="var(--color-blood)" stroke-width="1" stroke-dasharray="4 2" />
      <text x="71%" y="69%" fill="var(--color-blood)" font-family="monospace" font-size="9">INJECTOR_ACTIVE</text>
    </svg>
  </div>

  <!-- Pikselowe mrówki wzdłuż krawędzi -->
  <div class="pointer-events-none absolute top-3 right-8 z-30 font-mono text-[10px] text-[var(--color-ink-muted)] flex items-center gap-1.5" aria-hidden="true">
    <span class="text-[9px] text-[var(--color-blood)] font-bold">BLANKEU // SYSTEM ONLINE</span>
  </div>

  <!-- GŁÓWNA KOMPOZYCJA -->
  <div class="relative z-10 my-auto py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Lewa kolumna: Wielka typografia BLANKEU, badge i akcje -->
      <div class="lg:col-span-6 space-y-6">
        <!-- Zwięzły pasek techniczny -->
        <div class="inline-flex items-center gap-3 border border-[var(--color-blood)] bg-[var(--bg-shard)] px-3 py-1 font-mono text-[10px] text-[var(--color-blood)] shadow-[3px_3px_0_var(--color-blood)]">
          <span class="barcode-dense w-12 h-2.5 inline-block" aria-hidden="true"></span>
          <span class="font-black tracking-widest">{SITE.author.toUpperCase()}</span>
          <span class="text-[var(--color-acid)]">DEVLOG</span>
        </div>

        <!-- Wielki dekonstruowany tytuł BLANKEU -->
        <div class="relative select-none">
          <div class="font-display font-black text-7xl sm:text-9xl xl:text-[10.5rem] tracking-tighter leading-[0.80] text-[var(--color-blood)] opacity-30 absolute -top-1.5 -left-1.5 sm:-top-2 sm:-left-2 pointer-events-none transform skew-x-[-3deg]">
            {SITE.wordmark}
          </div>

          <h1 class="font-display font-black text-7xl sm:text-9xl xl:text-[10.5rem] tracking-tighter leading-[0.80] text-white breakcore-glitch transform skew-x-[-3deg]">
            {SITE.wordmark}
          </h1>

          <div class="flex flex-wrap items-center gap-2 mt-3">
            <span class="px-2 py-0.5 bg-[var(--color-blood)] text-black font-mono font-black text-xs sm:text-sm tracking-widest transform rotate-1">
              DEVLOG // EXPERIMENTAL ART
            </span>
          </div>
        </div>

        <!-- Przyciski wykonawcze (bez zbędnych ścian tekstu placeholderów) -->
        <div class="flex flex-wrap items-center gap-4 pt-2 font-mono text-xs sm:text-sm">
          <a
            href={getPostsUrl()}
            class="px-6 py-3.5 bg-[var(--color-blood)] text-black font-black hover:bg-white hover:text-black transition-all shadow-[4px_4px_0_white] inline-flex items-center gap-2 transform hover:-translate-y-0.5"
          >
            <span>PRZEGLĄDAJ WPISY</span>
            <span aria-hidden="true">→</span>
          </a>

          <a
            href={getArchiveUrl()}
            class="px-5 py-3.5 border-2 border-[var(--color-border)] text-[var(--color-ink)] hover:border-[var(--color-blood)] hover:text-[var(--color-blood)] bg-[var(--bg-shard)] transition-all font-bold"
          >
            ARCHIWUM ({totalPosts})
          </a>

          <button
            type="button"
            data-search-trigger
            class="px-4 py-3.5 border border-[var(--color-border)] text-[var(--color-ink-muted)] hover:text-white transition-colors"
            title="Szukaj (Ctrl+K)"
          >
            SZUKAJ [^K]
          </button>
        </div>
      </div>

      <!-- Prawa kolumna: Kaskada 3 okien z silnikiem ASCII -->
      <div class="lg:col-span-6 relative mt-8 lg:mt-0 min-h-[460px] sm:min-h-[520px] flex items-center justify-center">
        <!-- OKNO 1: BSOD Crash Dump Window -->
        <div class="absolute -top-4 -left-2 sm:-left-6 w-72 sm:w-80 border-2 border-[var(--color-blood)] bg-[#03030a] p-3 font-mono text-[9px] text-[var(--color-blood)] shadow-2xl z-10 transform -rotate-3 select-none pointer-events-none" aria-hidden="true">
          <div class="flex justify-between border-b border-[var(--color-blood)] pb-1 mb-1.5 text-[8px] font-bold">
            <span>KERNEL_PANIC // STOP 0x00000050</span>
            <span>_ [] X</span>
          </div>
          <div class="space-y-1 text-[8px] leading-tight text-white/80">
            <div>FAULT_IN_NONPAGED_AREA at 0xBF803000</div>
            <div>CHECK HARDWARE OR UPDATE TO PREVENT CORRUPTION</div>
          </div>
        </div>

        <!-- OKNO 2: Lain Code Stream Window -->
        <div class="absolute -bottom-6 -right-2 sm:-right-4 w-72 sm:w-84 border border-[var(--color-border)] bg-[var(--bg-void)]/95 p-3.5 font-mono text-[10px] text-white shadow-2xl z-20 transform rotate-3 select-none pointer-events-none" aria-hidden="true">
          <div class="flex justify-between border-b border-[var(--color-border)] pb-1 mb-1.5 text-[8px] text-[var(--color-acid)] font-bold">
            <span>MY COMPUTER // LAIN_RUN.EXE</span>
            <span>_ [] X</span>
          </div>
          <pre class="m-0 text-[9px] leading-tight text-[var(--color-acid)]">
world.runExecution();
if (world.isExecutableBy(me)) &#123;
  you.setExecution(me.toExec);
&#125;
me.escape(world);
// RESET_VECTOR: 0x9AF4
          </pre>
          <div class="mt-2 pt-1 border-t border-[var(--color-border)] flex justify-between text-[8px] text-[var(--color-ink-muted)]">
            <span>NODE_ACTIVE</span>
            <span>MEMORY_PAGES_CLEARED</span>
          </div>
        </div>

        <!-- OKNO 3 (GŁÓWNE / CENTRALNE): Czerwony Shard ASCII_CORE.v4 -->
        <div class="relative z-30 border-2 border-[var(--color-blood)] bg-[var(--bg-shard)] p-4 sm:p-5 shadow-[10px_10px_0_rgba(255,0,60,0.4)] crosshair-corners transform rotate-0.5 max-w-lg w-full">
          <div class="flex justify-between items-center border-b-2 border-[var(--color-blood)] pb-2 mb-3 font-mono text-[10px]">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 bg-[var(--color-blood)] inline-block animate-ping"></span>
              <span class="text-[var(--color-blood)] font-black tracking-wider">ASCII_CORE.v4 // NOISE_MATRIX</span>
            </div>
            <div class="flex items-center gap-1.5 text-[9px] text-[var(--color-ink-muted)] font-bold">
              <span>_</span>
              <span>[]</span>
              <span>X</span>
            </div>
          </div>

          <div class="overflow-hidden flex items-center justify-center min-h-[290px] sm:min-h-[360px] bg-black p-2 border border-[var(--color-border)]">
            <AsciiArt seed="blankeu-breakcore-master" cols={52} rows={21} style="glitch" themeColor="red" />
          </div>

          <div class="mt-3 pt-2 border-t border-[var(--color-border)] flex justify-between items-center font-mono text-[9px] text-[var(--color-ink-muted)]">
            <span class="text-[var(--color-blood)] font-bold">MODULATION: BREAKCORE_VALUE_NOISE</span>
            <span>MPU G510A // PAL 14.318MHz</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Dolny pas: Obszary tematyczne -->
  <div class="pt-6 mt-8 border-t border-[var(--color-border)] z-10 font-mono text-xs">
    <div class="flex items-center justify-between mb-3 text-[10px] text-[var(--color-ink-muted)]">
      <span class="text-[var(--color-blood)] font-black tracking-widest">[TEMATYKA]</span>
      <span class="hidden sm:inline">WYBIERZ KATEGORIĘ</span>
    </div>
    <div class="flex flex-wrap gap-2">
      {TAGS.map((t, idx) => (
        <a
          href={getTagUrl(t.slug)}
          class:list={[
            'px-3 py-1 border border-[var(--color-border)] bg-[var(--bg-shard)] text-[11px] text-[var(--color-ink)] hover:border-[var(--color-blood)] hover:text-[var(--color-blood)] hover:bg-[var(--bg-void)] transition-all font-bold tracking-wider transform',
            idx % 2 === 0 ? 'hover:rotate-1' : 'hover:-rotate-1',
          ]}
        >
          <span>{t.label.toUpperCase()}</span>
        </a>
      ))}
    </div>
  </div>
</section>
